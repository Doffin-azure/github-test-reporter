{{#if ctrf.tests}}
<table>
  <thead>
    <tr>
      <th>Test</th>
      <th>Duration</th>
    </tr>
  </thead>
  <tbody>
    {{#each ctrf.tests}}
    <tr>
      <td>{{name}}</td>
      <td>{{#if duration}}{{formatDurationMs duration}}{{else}}0ms{{/if}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
No test durations were captured in this run.
{{/if}}
